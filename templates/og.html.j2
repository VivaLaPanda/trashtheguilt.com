<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<style>
{{ css }}
html, body { margin: 0; width: 1200px; height: 630px; overflow: hidden; background: var(--page); }
.og { box-sizing: border-box; width: 1200px; height: 630px; padding: 64px 72px 56px; display: grid; grid-template-columns: 1fr {{ art_w }}px; gap: 56px; align-items: center; }
.og .num { font-size: {{ num_size }}px; line-height: 0.95; font-weight: 800; letter-spacing: -0.035em; margin: 0 0 28px; }
.og .line { font-size: 36px; line-height: 1.3; margin: 0; color: var(--ink); font-weight: 500; }
.og .domain { position: absolute; left: 72px; bottom: 52px; font-size: 26px; font-weight: 700; color: var(--accent-ink); letter-spacing: -0.01em; }
.og .art { display: flex; align-items: center; justify-content: center; height: 440px; }
.og .art svg { width: 100%; height: 100%; }
.og .art svg .t { font-size: 12px; }
</style>
</head>
<body>
<div class="og">
  <div>
    <p class="num">{{ num }}</p>
    {% if line %}<p class="line">{{ line }}</p>{% endif %}
  </div>
  <div class="art">{{ art }}</div>
</div>
<p class="domain">trashtheguilt.com</p>
</body>
</html>
