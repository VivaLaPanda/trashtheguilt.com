<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<style>
{{ css }}
html, body { margin: 0; width: 1200px; height: 630px; overflow: hidden; }
body.og-bg { background: var(--{{ band }}); }
.og { position: relative; box-sizing: border-box; width: 1200px; height: 630px; padding: 60px 72px 96px; display: grid; grid-template-columns: 1fr 440px; gap: 56px; align-items: center; }
.og .num { margin: 0 0 22px; font-family: var(--display); font-stretch: 62%; font-weight: 900; text-transform: uppercase; font-size: {{ 112 if band == "cream" else 170 }}px; line-height: 0.82; }
.og .line { margin: 0; font: 700 34px/1.25 var(--display); color: var(--ink); }
.og .art { background: var(--paper); border: 3px solid var(--ink); border-radius: 32px; height: 440px; display: flex; align-items: center; justify-content: center; padding: 28px; }
.og .art svg { width: 100%; height: 100%; }
.og .domain { position: absolute; left: 72px; bottom: 44px; margin: 0; font: 800 24px/1 var(--sans); background: var(--ink); color: var(--cream); padding: 12px 18px; border-radius: 999px; }
.og .swoosh { display: block; width: 360px; height: 30px; margin-top: 10px; }
.og .swoosh path { fill: none; stroke: var(--accent); stroke-width: 10; stroke-linecap: round; }
</style>
</head>
<body class="og-bg r-{{ {"aqua": "ocean", "lime": "landfills", "sun": "climate", "cream": "climate"}[band] }}">
<div class="og">
  <div>
    <p class="num">{{ num | safe }}</p>
    {% if line %}<p class="line">{{ line }}</p>{% endif %}
  </div>
  <div class="art">{{ art }}</div>
  <p class="domain">trashtheguilt.com</p>
</div>
</body>
</html>
